# ==============================================================
# FinPulse — Environment Variables Template
# ==============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
# ==============================================================

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string (required)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:password@localhost:5432/finpulse

# ── Server ──────────────────────────────────────────────────
# Port the Express server listens on (default: 5000)
PORT=5000

# Node environment: "development" | "production" | "test"
NODE_ENV=development

# The public base URL of this server (no trailing slash).
# Used to construct file download URLs sent to n8n.
# Example: https://your-app.vercel.app
SERVER_BASE_URL=http://localhost:5000

# ── Session ─────────────────────────────────────────────────
# Secret used to sign session cookies (required in production).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_me_to_a_random_64_char_hex_string

# ── n8n Integration ─────────────────────────────────────────
# Webhook URL of your n8n workflow that processes uploaded CSVs.
# Leave empty to skip n8n dispatch during development.
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/finpulse-ledger

# Shared secret for verifying incoming webhook signatures from n8n.
# Must match the secret configured in your n8n workflow.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_SECRET=change_me_to_a_random_32_char_hex_string

# ── Direct AI Integration (bypasses n8n) ───────────────────
# Set AI_API_KEY to use an OpenAI-compatible AI provider directly.
# The server will call the AI model when N8N_WEBHOOK_URL is not set.
# Supports any OpenAI-compatible API (OpenAI, AIHumaX, Groq, Together, local Ollama, etc.)
AI_API_KEY=sk-your-ai-api-key-here

# Base URL for the AI API (default: https://api.openai.com/v1)
# For AIHumaX: https://api.aihumax.com/v1 (example — replace with actual endpoint)
AI_API_BASE_URL=https://api.openai.com/v1

# Model to use for analysis (default: gpt-4o-mini)
# Common options: gpt-4o, gpt-4o-mini, gpt-3.5-turbo, claude-3-5-sonnet-20240620
AI_MODEL=gpt-4o-mini

# ── Client (Vite — prefix with VITE_ to expose to browser) ──
# These are only needed if you add client-side env var usage.
# VITE_API_BASE_URL=http://localhost:5000
