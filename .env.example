# ==============================================================
# FinPulse — Environment Variables Template
# ==============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
# ==============================================================

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string (required)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:password@localhost:5432/finpulse

# ── Server ──────────────────────────────────────────────────
# Port the Express server listens on (default: 5000)
PORT=5000

# Node environment: "development" | "production" | "test"
NODE_ENV=development

# The public base URL of this server (no trailing slash).
# Used to construct file download URLs sent to n8n.
# Example: https://your-app.vercel.app
SERVER_BASE_URL=http://localhost:5000

# ── Session ─────────────────────────────────────────────────
# Secret used to sign session cookies (required in production).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_me_to_a_random_64_char_hex_string

# ── n8n Integration ─────────────────────────────────────────
# Webhook URL of your n8n workflow that processes uploaded CSVs.
# Leave empty to skip n8n dispatch during development.
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/finpulse-ledger

# Shared secret for verifying incoming webhook signatures from n8n.
# Must match the secret configured in your n8n workflow.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_SECRET=change_me_to_a_random_32_char_hex_string

# ── Client (Vite — prefix with VITE_ to expose to browser) ──
# These are only needed if you add client-side env var usage.
# VITE_API_BASE_URL=http://localhost:5000
